# Copy to .env (never commit .env). All variables are optional in development.

# dev | prod  (dev enables POST /api/v1/auth/dev-login and the demo quote jitter)
FORLIOSA_ENV=dev

# SQLite for local development; PostgreSQL in production. A Railway-style postgresql:// URL is
# rewritten to postgresql+psycopg:// automatically.
DATABASE_URL=sqlite:///./var/forliosa.db
# DATABASE_URL=postgresql+psycopg://forliosa:forliosa@localhost:5432/forliosa

# Optional (reserved for the shared quote cache / job queue; not required yet)
REDIS_URL=

# Comma-separated origins allowed to call the API with cookies (the Vite dev server by default)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Required in prod: a long random string (e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`)
SESSION_SECRET=change-me
# COOKIE_DOMAIN=.example.com   # share the session cookie between app. and api. subdomains

# commercial (default): only legally commercially usable data — government open data (TWSE / TPEx
#   OpenAPI, TDCC open data), shioaji-data's official files and our own archive built from them. Never demo
#   data: where the archive is still short, endpoints return empty series with a 「資料累積中」 note.
# personal: explicit opt-in for the developer's own use; demo data fills gaps and FinMind can be enabled by
#   adding `finmind` to MARKET_DATA_PROVIDERS (labelled 「非商用」).
# In no mode does the server download from the TWSE / TPEx / MIS / MOPS websites (their terms forbid it).
DATA_POLICY=commercial

# Market data providers, highest priority first, with fallback:
#   archive       our own daily archive of official open data (python -m forliosa.archive)
#   twse_openapi, tpex_openapi   official after-close data (latest day only)
#   shioaji_data  instrument master, company profiles, monthly revenue, quarterly statements
#   demo          synthetic data; under commercial it only names instruments (catalog), never serves data
#   finmind       NOT default — non-commercial; only built when DATA_POLICY=personal and listed here
MARKET_DATA_PROVIDERS=archive,twse_openapi,tpex_openapi,shioaji_data,demo
# Optional FinMind token (personal opt-in only; anonymous quota is small). Never commit it.
FINMIND_TOKEN=
CACHE_DIR=var/cache
STREAM_INTERVAL_SECONDS=5
# DEMO_JITTER=true
