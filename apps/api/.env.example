# Copy to .env (never commit .env). All variables are optional in development.

# dev | prod  (dev enables POST /api/v1/auth/dev-login and the demo quote jitter)
FORLIOSA_ENV=dev

# SQLite for local development; PostgreSQL in production. A Railway-style postgresql:// URL is
# rewritten to postgresql+psycopg:// automatically.
DATABASE_URL=sqlite:///./var/forliosa.db
# DATABASE_URL=postgresql+psycopg://forliosa:forliosa@localhost:5432/forliosa

# Optional (reserved for the shared quote cache / job queue; not required yet)
REDIS_URL=

# Comma-separated origins allowed to call the API with cookies (the Vite dev server by default)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Required in prod: a long random string (e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`)
SESSION_SECRET=change-me
# COOKIE_DOMAIN=.example.com   # share the session cookie between app. and api. subdomains

# The frontend origin: Discord login redirects back to it and invite links point at it. Required in prod (https and one
# of CORS_ORIGINS); in development the first CORS origin is used when empty.
FRONTEND_URL=

# Sign in with Discord (M5): set all three or none (prod refuses a partial setup). Never commit the secret.
# DISCORD_REDIRECT_URI must match the Discord Developer Portal exactly (see docs/deploy.md §2.4).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8000/api/v1/auth/discord/callback

# Sign in with Google (optional): set all three (docs/deploy.md §2.4.1). A partial setup keeps Google off and logs a
# warning; it does not stop the API. Never commit the secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Group push to Telegram (M5): without both, telegram_available is false. Set on the api AND the worker (the worker polls
# getUpdates and sends; run a single worker). Never commit the token. See docs/deploy.md §2.5.
# The worker also needs the api's SESSION_SECRET (it decrypts the Discord webhooks of group channels) and FRONTEND_URL
# (the group link in pushed messages).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# commercial (default): only legally commercially usable data — government open data (TWSE / TPEx
#   OpenAPI, TDCC open data), shioaji-data's official files and our own archive built from them. Never demo
#   data: where the archive is still short, endpoints return empty series with a 「資料累積中」 note.
# personal: explicit opt-in for the developer's own use; demo data fills gaps and FinMind can be enabled by
#   adding `finmind` to MARKET_DATA_PROVIDERS (labelled 「非商用」).
# In no mode does the server download from the TWSE / TPEx / MIS / MOPS websites (their terms forbid it).
DATA_POLICY=commercial

# Market data providers, highest priority first, with fallback:
#   archive       our own daily archive of official open data (python -m forliosa.archive)
#   twse_openapi, tpex_openapi   official after-close data (latest day only)
#   shioaji_data  instrument master, company profiles, monthly revenue, quarterly statements
#   demo          synthetic data; under commercial it only names instruments (catalog), never serves data
#   finmind       NOT default — non-commercial; only built when DATA_POLICY=personal and listed here
MARKET_DATA_PROVIDERS=archive,twse_openapi,tpex_openapi,shioaji_data,demo
# Optional FinMind token (personal opt-in only; anonymous quota is small). Never commit it.
FINMIND_TOKEN=
CACHE_DIR=var/cache
STREAM_INTERVAL_SECONDS=5
# DEMO_JITTER=true

# -- AI (Claude) -------------------------------------------------------------------------------------
# One key per Anthropic workspace; the number is the key slot. Never commit real keys.
# CLAUDE_API_KEY_1=
# CLAUDE_API_KEY_2=
# CLAUDE_API_KEY_3=
# Optional estimated spend cap per slot and UTC month (empty = no cap; keep it below the Console's workspace limit)
# AI_KEY_1_MONTHLY_BUDGET_USD=50
# AI_KEY_2_MONTHLY_BUDGET_USD=50
# AI_KEY_3_MONTHLY_BUDGET_USD=50
# AI_DAILY_MESSAGE_LIMIT=50
# AI_MONTHLY_TOKEN_BUDGET=3000000
# AI_WHY_ENABLED=true
# AI_RETENTION_DAYS=30
# AI_DIGEST_ENABLED=true    # group weekly digests (worker, Saturday 20:00 Taipei; Message Batches; charged to no user)
# AI_MODEL_DIGEST=          # override the digest model (default: AI_MODEL)
# AI_ADMIN_EMAILS=          # who may read GET /ai/admin/keys in prod

# -- News (stock page 「新聞報導」: headline, outlet, time, link only) ------------------------------------------
# NEWS_ENABLED=true
# NEWS_REFRESH_MINUTES=45          # worker batch over held / watched / recently viewed symbols
# NEWS_GDELT_INTERVAL_SECONDS=6    # GDELT allows one request every 5 s per IP; a 429 pauses the source
# NEWS_AI_ENABLED=true             # AI web search only when GDELT + SearXNG gave fewer than NEWS_AI_MIN_ITEMS (3) in 7 days
# NEWS_AI_BUDGET_USD=30            # system-paid monthly cap (UTC month, ai_usage feature "news")
# Our private SearXNG (deploy/searxng) is ON by default. Unset NEWS_SEARXNG_URL = the default for FORLIOSA_ENV:
# prod -> http://searxng.railway.internal:8080 (the Railway service "searxng"), dev -> http://localhost:8080 (the
# compose service: docker compose -f deploy/searxng/docker-compose.yml up -d --build). An unreachable instance only
# pauses the source. Check it: uv run python -m forliosa.news searxng-check "台積電"
# NEWS_SEARXNG_ENABLED=true        # false turns SearXNG off (so does NEWS_SEARXNG_URL= set but empty)
# NEWS_SEARXNG_URL=http://localhost:8080
# NEWS_SEARXNG_INTERVAL_SECONDS=10 # one query at a time, at least 10 s apart
# NEWS_SEARXNG_CACHE_MINUTES=60    # a symbol SearXNG answered is not asked again sooner (30 or more)
# NEWS_SEARXNG_SKIP_GDELT_ITEMS=8  # skip SearXNG for a symbol with this many GDELT headlines from the last 24 h
# NEWS_SEARXNG_BACKOFF_MINUTES=120 # an upstream engine that refused (CAPTCHA, 429) is paused this long, doubling
# NEWS_SEARXNG_ENGINES=bing news,duckduckgo news,brave.news   # must match deploy/searxng/settings.yml
# SEARXNG_SECRET is SearXNG's own secret key: set it on the searxng service (Railway variable, or
# deploy/searxng/.env for compose), never here — the API and worker do not use it.
# NEWS_YAHOO_RSS=true              # only used under DATA_POLICY=personal (non-commercial terms)
# NEWS_BLOCKED_DOMAINS=            # takedowns, comma-separated (also: python -m forliosa.news block <domain>)

# -- 「關於〈公司〉」 description: zh.wikipedia excerpt (CC BY-SA 4.0, unchanged) or an AI description from official facts
# COMPANY_DESCRIPTIONS_ENABLED=true   # worker job company_refresh, hourly, tracked / recently viewed stocks
# COMPANY_AI_ENABLED=true             # AI 2–3 sentences only without an article (system-paid, ai_usage feature "company")
# COMPANY_AI_PER_RUN=10
# COMPANY_MAX_SYMBOLS_PER_RUN=15      # Wikimedia lookups per run (one request at a time)
# COMPANY_WIKI_REFRESH_DAYS=30
# AI_MODEL_COMPANY=                   # default: AI_MODEL
# WIKIMEDIA_CONTACT=                  # optional contact in the Wikimedia User-Agent; never reuse SEC_CONTACT_EMAIL
