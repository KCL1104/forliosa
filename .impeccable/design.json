      "css": ".ds-rail{background:oklch(0.255 0.05 263);padding:8px;width:220px;display:flex;flex-direction:column;gap:2px}.ds-rail a{display:flex;justify-content:space-between;height:40px;align-items:center;padding:0 12px;border-radius:6px;color:oklch(0.76 0.035 255);font-size:14px}.ds-rail a:hover{background:color-mix(in oklch,oklch(0.345 0.07 262) 60%,transparent);color:#fff}.ds-rail a[aria-current=page]{background:oklch(0.345 0.07 262);color:oklch(0.94 0.012 250);font-weight:500}.ds-rail small{font-size:12px;opacity:.8}"
