  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "藍黑墨底的主要動作，一個畫面最多一個。",
      "html": "<button class=\"ds-btn-primary\">記一筆</button>",
      "css": ".ds-btn-primary{background:var(--act,#1f2a44);color:var(--act-fg,#fbfbf8);border:1px solid transparent;border-radius:4px;height:40px;padding:0 12px;font:500 14px/1 'Noto Sans TC Variable',sans-serif;cursor:pointer;transition:background-color .12s,transform .14s cubic-bezier(.23,1,.32,1)}.ds-btn-primary:hover{background:var(--act-hover,#0f1730)}.ds-btn-primary:active{transform:scale(.97)}.ds-btn-primary:focus-visible{outline:2px solid var(--ink,#1f2a44);outline-offset:2px}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "1px 鉛筆灰框的次要動作。",
      "html": "<button class=\"ds-btn-outline\">修改</button>",
      "css": ".ds-btn-outline{background:transparent;color:var(--ink,#1f2a44);border:1px solid var(--ctl,#838ca0);border-radius:4px;height:40px;padding:0 12px;font:500 14px/1 'Noto Sans TC Variable',sans-serif;cursor:pointer;transition:background-color .12s}.ds-btn-outline:hover{background:var(--hov,#f2f4f8)}.ds-btn-outline:focus-visible{outline:2px solid var(--ink,#1f2a44);outline-offset:2px}"
    },
    {
      "name": "Segmented",
      "kind": "nav",
      "refersTo": "segmented-active",
      "description": "帳本分段：持倉・交易・股利・績效；選取＝墨色實底。",
      "html": "<div class=\"ds-seg\" role=\"tablist\"><button role=\"tab\" aria-selected=\"true\">持倉 <span>9</span></button><button role=\"tab\" aria-selected=\"false\">交易 <span>144</span></button><button role=\"tab\" aria-selected=\"false\">股利</button><button role=\"tab\" aria-selected=\"false\">績效</button></div>",
      "css": ".ds-seg{display:inline-flex;gap:4px;padding:4px;border:1px solid var(--ctl,#838ca0);border-radius:6px}.ds-seg button{height:34px;padding:0 16px;border:0;border-radius:4px;background:none;color:var(--ink-2,#5b6478);font:400 15px 'Noto Sans TC Variable',sans-serif;cursor:pointer}.ds-seg button span{font-size:13px;opacity:.85}.ds-seg button:hover{background:var(--hov,#f2f4f8);color:var(--ink,#1f2a44)}.ds-seg button[aria-selected=true]{background:var(--act,#1f2a44);color:var(--act-fg,#fbfbf8);font-weight:500}.ds-seg button:focus-visible{outline:2px solid var(--ink,#1f2a44);outline-offset:2px}"
    },
    {
      "name": "Suggestion Card",
      "kind": "chip",
      "refersTo": "suggestion-card",
      "description": "依頁面與資料自動出現的建議問題（不加說明字樣）。",
      "html": "<button class=\"ds-suggest\">今天誰拖累了我的報酬？<svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M7.9 20A9 9 0 1 0 4 16.1L2 22z\"/><path d=\"M9.1 9a3 3 0 0 1 5.8 1c0 2-3 3-3 3M12 17h.01\"/></svg></button>",
      "css": ".ds-suggest{display:flex;align-items:center;justify-content:space-between;gap:12px;width:340px;height:52px;padding:0 14px 0 16px;background:var(--raised,#fff);color:var(--ink,#1f2a44);border:1px solid var(--rule,#d6dee8);border-radius:6px;font:400 15px 'Noto Sans TC Variable',sans-serif;text-align:left;cursor:pointer}.ds-suggest svg{color:var(--ai,#4a5262);flex:none}.ds-suggest:hover{border-color:var(--ctl,#838ca0)}.ds-suggest:focus-visible{outline:2px solid var(--ink,#1f2a44);outline-offset:2px}"
    },
    {
      "name": "Draft Card with Sign Box",
      "kind": "custom",
      "refersTo": "draft-card",
      "description": "AI 草稿（石墨灰虛線、尚未生效）與方形「簽名｜確認入帳」格。",
      "html": "<article class=\"ds-draft\"><h3>買進 元大台灣50 <small>0050</small></h3><p>成交日 11/12（四）</p><dl><div><dt>股數</dt><dd>2,000 股</dd></div><div><dt>成交價</dt><dd>@52.40</dd></div><div><dt>手續費</dt><dd>41</dd></div><div><dt>證交稅</dt><dd>0</dd></div><div class=\"sum\"><dt>合計</dt><dd>NT$104,841</dd></div></dl><footer><a>怎麼算的 ⌄</a><button class=\"ds-btn-outline\">修改</button><button class=\"ds-sign\"><small>簽名</small>確認入帳</button></footer></article>",
      "css": ".ds-draft{width:340px;border:1px dashed var(--ai-rule,#8b919f);background:var(--ai-wash,#f1f2f4);font-family:'Noto Sans TC Variable',sans-serif}.ds-draft h3{margin:0;padding:14px 16px 0;font-size:17px;color:var(--ai,#4a5262)}.ds-draft h3 small{font-size:13px;font-weight:400}.ds-draft p{margin:0;padding:2px 16px 12px;font-size:13px;color:var(--ink-2,#5b6478);border-bottom:1px solid var(--rule,#d6dee8)}.ds-draft dl{display:grid;grid-template-columns:1fr 1fr;margin:0}.ds-draft dl div{display:flex;justify-content:space-between;padding:10px 16px;border-bottom:1px solid var(--rule,#d6dee8)}.ds-draft dl div:nth-child(odd):not(.sum){border-right:1px solid var(--rule,#d6dee8)}.ds-draft dt{font-size:13px;color:var(--ink-2,#5b6478)}.ds-draft dd{margin:0;font-weight:500;color:var(--ai,#4a5262)}.ds-draft .sum{grid-column:1/3}.ds-draft .sum dt{font-weight:700;color:var(--ink,#1f2a44)}.ds-draft .sum dd{font-size:20px;font-weight:700}.ds-draft footer{display:flex;align-items:center;gap:10px;padding:12px 12px 12px 16px}.ds-draft footer a{margin-right:auto;font-size:13px;color:var(--ai,#4a5262);text-decoration:underline}.ds-draft .ds-btn-outline{height:36px;padding:0 10px;border:1px solid var(--ctl,#838ca0);border-radius:4px;background:none}.ds-sign{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;width:76px;height:60px;border:0;border-radius:0;background:var(--act,#1f2a44);color:var(--act-fg,#fbfbf8);font-weight:700;font-size:14px;cursor:pointer}.ds-sign::after{content:'';position:absolute;inset:3px;border:1px solid currentColor;opacity:.4}.ds-sign small{font-size:12px;font-weight:400}.ds-sign:hover{background:var(--act-hover,#0f1730)}.ds-sign:active{transform:scale(.97)}.ds-sign:focus-visible{outline:2px solid var(--ai,#4a5262);outline-offset:2px}"
    },
    {
      "name": "AI Composer",
      "kind": "input",
      "refersTo": "composer",
      "description": "AI 的主要入口：提問、記帳指令、（手機）搜尋。",
      "html": "<form class=\"ds-composer\"><textarea placeholder=\"提出問題，或直接說：買 0050 2 張 52.4\"></textarea><div><button type=\"button\" class=\"plus\">+</button><button class=\"go\">↑</button></div></form>",
      "css": ".ds-composer{width:340px;padding:12px 10px 10px 14px;border:1px solid var(--act,#1f2a44);border-radius:6px;background:var(--raised,#fff)}.ds-composer:focus-within{outline:2px solid var(--ink,#1f2a44);outline-offset:2px}.ds-composer textarea{display:block;width:100%;height:54px;border:0;outline:0;resize:none;background:none;font:400 15px/1.6 'Noto Sans TC Variable',sans-serif;color:var(--ink,#1f2a44)}.ds-composer textarea::placeholder{color:var(--ink-2,#5b6478)}.ds-composer div{display:flex;justify-content:space-between;margin-top:6px}.ds-composer .plus{width:36px;height:36px;border:1px solid var(--rule,#d6dee8);border-radius:4px;background:none;color:var(--ink-2,#5b6478)}.ds-composer .go{width:36px;height:36px;border:0;border-radius:4px;background:var(--act,#1f2a44);color:var(--act-fg,#fbfbf8)}"
    },
    {
      "name": "Demo Tag",
      "kind": "chip",
      "refersTo": "demo-tag",
      "description": "示範資料：資料狀態，不是品牌。",
