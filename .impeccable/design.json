      "html": "<section class=\"ds-panel\"><h2>即將除權息</h2><p>11/18 國泰永續高股息　每股 0.55 元</p></section>",
      "css": ".ds-panel{background:oklch(0.996 0.002 195);border:1px solid oklch(0.885 0.009 215);border-radius:10px;padding:12px 20px 16px}.ds-panel h2{margin:0 0 8px;font-size:16px;font-weight:600}.ds-panel p{margin:0;font-size:14px;font-variant-numeric:tabular-nums}"
