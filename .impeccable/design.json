      "name": "Chop 章",
      "kind": "chip",
      "refersTo": "chop",
      "description": "資料狀態標記：示範資料、預估、即將推出、已入帳。",
      "html": "<span class=\"ds-chop\">示範資料</span> <span class=\"ds-chop ds-chop-muted\">M4 推出</span>",
      "css": ".ds-chop{display:inline-flex;align-items:center;height:22px;padding:0 5.6px;border:1.5px solid currentColor;border-radius:3px;font-size:12px;font-weight:600;letter-spacing:.06em;line-height:1;color:var(--primary,oklch(0.44 0.135 259));white-space:nowrap}.ds-chop-muted{color:var(--muted-foreground,oklch(0.47 0.018 255))}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "主要動作：記一筆、儲存。",
      "html": "<button class=\"ds-btn\">＋ 記一筆</button>",
      "css": ".ds-btn{height:36px;padding:0 12px;border:0;border-radius:6px;background:var(--primary,oklch(0.44 0.135 259));color:#fff;font-size:14px;font-weight:500;transition:transform 140ms cubic-bezier(.23,1,.32,1),background-color 140ms}.ds-btn:hover{background:color-mix(in oklch,var(--primary,oklch(0.44 0.135 259)) 88%,transparent)}.ds-btn:active{transform:scale(.97)}.ds-btn:focus-visible{outline:2px solid var(--ring,oklch(0.52 0.14 258));outline-offset:2px}"
    },
    {
      "name": "Segmented",
      "kind": "custom",
      "refersTo": "segmented-active",
      "description": "區間與分類切換。",
      "html": "<div class=\"ds-seg\" role=\"radiogroup\"><button role=\"radio\" aria-checked=\"false\">1M</button><button role=\"radio\" aria-checked=\"true\">1Y</button><button role=\"radio\" aria-checked=\"false\">全部</button></div>",
      "css": ".ds-seg{display:flex;gap:2px}.ds-seg button{height:32px;padding:0 10px;border:0;border-radius:6px;background:transparent;color:oklch(0.47 0.018 255);font-size:13px;font-weight:500}.ds-seg button:hover{background:oklch(0.945 0.007 205);color:oklch(0.23 0.025 262)}.ds-seg button[aria-checked=true]{background:oklch(0.935 0.022 255);color:oklch(0.32 0.09 259);box-shadow:inset 0 0 0 1px color-mix(in oklch,oklch(0.44 0.135 259) 30%,transparent)}"
    },
    {
      "name": "Panel",
