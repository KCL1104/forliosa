  "narrative": {
    "northStar": "蓋章為憑（The Bank-Counter Seal）",
    "overview": "Forliosa 借用台灣銀行臨櫃的印鑑與印台：資料狀態以方形章標示。Operate 介面，世界只提供字型、色盤、密度與章這個招牌動作；導覽與控制項都是標準元件。首頁簡潔、細節頁密集。",
    "keyCharacteristics": [
      "青田石冷灰底＋靛青墨側欄",
      "印泥藍是唯一操作色",
      "朱泥只在品牌章",
      "紅綠只表示漲跌並配 ▲▼",
      "全站等寬數字，大數字用比例數字",
      "細線而非陰影"
    ],
    "rules": [
      {
        "name": "The One Job Rule",
        "body": "每個顏色只有一個工作。",
        "section": "colors"
      },
      {
        "name": "The Glyph Pair Rule",
        "body": "漲跌顏色一定配 ▲▼。",
        "section": "colors"
      },
      {
        "name": "The Tabular Ledger Rule",
        "body": "全站等寬數字；獨立大數字用比例數字；負號用 U+2212。",
        "section": "typography"
      }
    ],
    "dos": [
      "用章標示資料狀態",
      "隱私模式遮蔽金額與股數、保留百分比",
      "空狀態給一個現在能做的動作"
    ],
    "donts": [
      "朱泥紅不出現在品牌章以外",
      "不用雙 Y 軸",
      "不用玻璃模糊與漸層文字",
      "不加 eyebrow 小標"
    ]
  }
